{
  "version": 2,
  "builds": [
    { "src": "api/**/*.php", "use": "@vercel/php" },
    { "src": "**/*.php", "use": "@vercel/php" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.php" },
    { "src": "^/(.*\\.php)$", "dest": "/$1" },
    { "src": "(.*)", "dest": "/index.php" }
  ]
}
